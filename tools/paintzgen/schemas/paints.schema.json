{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paintz.local/schemas/paints.schema.json",
  "title": "PaintZ paint manifest",
  "type": "object",
  "required": ["schema_version", "generator", "paints"],
  "properties": {
    "schema_version": {"const": 1},
    "generator": {
      "type": "object",
      "properties": {
        "pattern_scales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10
          }
        }
      },
      "additionalProperties": true
    },
    "dayz": {"type": "object"},
    "paints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{2,12}$",
            "description": "Preferred explicit product-ID suffix. Three descriptive characters are recommended, e.g. WHT, UCP, FDE."
          },
          "name": {"type": "string", "minLength": 1},
          "type": {
            "enum": ["solid", "camo", "pattern", "metallic", "rusted", "weathered", "fluorescent", "special", "custom", "transparent"]
          },
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "pattern": {"type": "string", "minLength": 1},
          "appearance_profile": {"type": "string", "minLength": 1},
          "finish": {"type": "string"},
          "field_text": {"type": "string"},
          "dayz_class": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "Optional explicit PaintZ config/script classname. When omitted, the generator uses PaintZ_SprayCan_ID."
          }
        },
        "oneOf": [
          {"required": ["color"], "not": {"required": ["pattern"]}},
          {"required": ["pattern"], "not": {"required": ["color"]}}
        ],
        "additionalProperties": false
      }
    }
  }
}
